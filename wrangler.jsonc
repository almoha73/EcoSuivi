{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ecosuivi",
    "main": "worker.js",
    "compatibility_date": "2026-09-21",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*"
        ]
    }
}
